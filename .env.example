# Token bot dari https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
CLIENT_ID=
# ID server Discord anda (klik kanan nama server -> Copy Server ID)
GUILD_ID=
# Zon masa untuk semua jadual (topik harian, aktiviti mingguan, reset bulanan)
TIMEZONE=Asia/Kuala_Lumpur
# Masa topik harian dihantar (format cron). Default: setiap hari 12:00 tengah hari
DAILY_TOPIC_CRON=0 12 * * *
